// BRITE POOL Database Schema
// PostgreSQL database configuration

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Core User & Authentication Models

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  name          String
  role          UserRole  @default(STEWARD)

  // Membership Level: 1 = Regular Member, 2 = Admin Access
  membershipLevel Int     @default(1)

  // Covenant & Membership
  covenantAcceptedAt  DateTime?
  covenantVersion     String?
  covenantIpAddress   String?

  // Onboarding
  onboardingCompleted Boolean  @default(false)
  onboardingStep      Int      @default(0)

  // Subscription
  subscriptionTier    SubscriptionTier @default(FREE)
  subscriptionStatus  SubscriptionStatus @default(INACTIVE)

  // Timestamps
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastLoginAt   DateTime?

  // Relations
  profile       UserProfile?
  sessions      Session[]
  committees    CommitteeMember[]
  tasks         Task[]
  participationLogs ParticipationLog[]
  forumPosts    ForumPost[]
  eventRegistrations EventRegistration[]
  mediaUploads  MediaItem[] @relation("MediaUploads")
  mapLocations  MapLocation[] @relation("MapLocationsCreated")
  coursesCreated Course[] @relation("CoursesCreated")
  courseProgress CourseProgress[] @relation("CourseProgress")
  maintenanceSubmitted MaintenanceRequest[] @relation("MaintenanceRequestsSubmitted")
  maintenanceAssigned MaintenanceRequest[] @relation("MaintenanceRequestsAssigned")
  maintenanceResolved MaintenanceRequest[] @relation("MaintenanceRequestsResolved")
  documentsUploaded Document[] @relation("DocumentsUploaded")

  // Pool System Relations
  cutOverseer         PoolCut[]          @relation("CutOverseer")
  invitationsSent     PoolInvitation[]   @relation("InvitationsSent")
  invitationsAccepted PoolInvitation[]   @relation("InvitationsAccepted")
  pledges             Pledge[]           @relation("MemberPledges")

  // Committee Chat & Document Relations
  chatMessages        CommitteeChatMessage[] @relation("ChatMessagesAuthored")
  committeeDocumentsUploaded CommitteeDocument[] @relation("CommitteeDocumentsUploaded")

  // Event relations
  eventsCreated       Event[] @relation("EventsCreated")
  eventApprovalsGiven EventApproval[] @relation("EventApprovalsGiven")
  notifications       Notification[] @relation("NotificationsReceived")

  // Wealth Generation Opportunities
  wgoCreated          WealthOpportunity[] @relation("WGOCreated")
  wgoInvolvements     UserWGOInvolvement[] @relation("UserWGOInvolvements")

  // Communal Seat Submissions
  communalSeatSubmissions CommunalSeatSubmission[] @relation("CommunalSeatSubmissions")
  communalSeatReviews     CommunalSeatSubmission[] @relation("CommunalSeatReviews")

  @@index([email])
  @@index([role])
  @@index([membershipLevel])
}

model UserProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  bio             String?
  phone           String?
  location        String?
  timezone        String   @default("UTC")
  language        String   @default("en")

  // Sacred Ledger
  totalEquityUnits Float   @default(0)
  totalHoursLogged Float   @default(0)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token        String   @unique
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([token])
}

// Enums

enum UserRole {
  WEB_STEWARD
  BOARD_CHAIR
  COMMITTEE_LEADER
  CONTENT_MODERATOR
  SUPPORT_STAFF
  STEWARD
  PARTNER
  RESIDENT
}

enum SubscriptionTier {
  FREE
  BASIC
  PREMIUM
  PLATINUM
}

enum SubscriptionStatus {
  ACTIVE
  INACTIVE
  PAST_DUE
  CANCELLED
}

// Covenant/Contract Models

model ContractVersion {
  id          String   @id @default(cuid())
  version     String   @unique
  content     String   // Full markdown/HTML content
  publishedAt DateTime @default(now())
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@index([isActive])
}

// Committee Models

model Committee {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  type        CommitteeType

  members     CommitteeMember[]
  tasks       Task[]
  events      Event[]
  eventCommittees EventCommittee[] @relation("EventCommittees")
  chats       CommitteeChat[]
  documents   CommitteeDocument[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CommitteeMember {
  id          String   @id @default(cuid())
  userId      String
  committeeId String
  role        CommitteeMemberRole @default(MEMBER)

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  committee   Committee @relation(fields: [committeeId], references: [id], onDelete: Cascade)

  joinedAt    DateTime @default(now())

  @@unique([userId, committeeId])
  @@index([committeeId])
  @@index([userId])
}

enum CommitteeType {
  GOVERNANCE
  WEALTH
  EDUCATION
  HEALTH
  OPERATIONS
}

enum CommitteeMemberRole {
  LEADER
  MEMBER
}

// Participation & Sacred Ledger

model ParticipationLog {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  hours       Float
  description String
  category    String
  status      ParticipationStatus @default(PENDING)

  approvedBy  String?
  approvedAt  DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

enum ParticipationStatus {
  PENDING
  APPROVED
  REJECTED
}

// Tasks

model Task {
  id          String   @id @default(cuid())
  title       String
  description String?
  status      TaskStatus @default(TODO)
  priority    TaskPriority @default(MEDIUM)

  assignedToId String?
  assignedTo   User?     @relation(fields: [assignedToId], references: [id])

  committeeId  String?
  committee    Committee? @relation(fields: [committeeId], references: [id])

  dueDate      DateTime?
  completedAt  DateTime?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([assignedToId])
  @@index([status])
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// Events

model Event {
  id          String   @id @default(cuid())
  title       String
  description String?
  type        EventType
  category    String?  // Committee-specific category (stored as string for flexibility)
  status      EventStatus @default(PENDING)

  startTime   DateTime
  endTime     DateTime
  location    String?
  virtualLink String?

  capacity    Int?

  // Creator/requester of the event
  createdById String
  createdBy   User @relation("EventsCreated", fields: [createdById], references: [id])

  // Multi-committee support (many-to-many)
  committees  EventCommittee[]

  // Legacy single committee (kept for backwards compatibility)
  committeeId String?
  committee   Committee? @relation(fields: [committeeId], references: [id])

  // Rejection details
  rejectionReason String?
  rejectedById    String?
  rejectedAt      DateTime?

  registrations EventRegistration[]
  approvals     EventApproval[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([startTime])
  @@index([type])
  @@index([status])
  @@index([createdById])
}

// Junction table for Event <-> Committee many-to-many
model EventCommittee {
  id          String   @id @default(cuid())
  eventId     String
  committeeId String

  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  committee   Committee @relation("EventCommittees", fields: [committeeId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())

  @@unique([eventId, committeeId])
  @@index([eventId])
  @@index([committeeId])
}

// Track approvals for multi-committee events
model EventApproval {
  id          String   @id @default(cuid())
  eventId     String
  committeeId String
  approverId  String

  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  approver    User     @relation("EventApprovalsGiven", fields: [approverId], references: [id])

  approvedAt  DateTime @default(now())

  @@unique([eventId, committeeId])
  @@index([eventId])
  @@index([approverId])
}

model EventRegistration {
  id        String   @id @default(cuid())
  userId    String
  eventId   String
  status    RegistrationStatus @default(REGISTERED)

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  registeredAt DateTime @default(now())

  @@unique([userId, eventId])
  @@index([eventId])
}

// Notifications
model Notification {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation("NotificationsReceived", fields: [userId], references: [id], onDelete: Cascade)

  type        NotificationType
  title       String
  message     String
  link        String?  // Optional link to related resource

  isRead      Boolean  @default(false)
  readAt      DateTime?

  // Related entity IDs for reference
  eventId     String?
  committeeId String?

  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}

enum NotificationType {
  EVENT_APPROVED
  EVENT_REJECTED
  EVENT_PENDING_APPROVAL
  GENERAL
}

enum EventType {
  COMMITTEE_MEETING
  WORKSHOP
  SANCTUARY_EVENT
  VIRTUAL_WEBINAR
}

enum EventStatus {
  PENDING
  APPROVED
  REJECTED
}

// Committee-specific event categories
enum GovernanceEventCategory {
  AGREEMENTS
  VOTING
  MEETINGS
}

enum WealthEventCategory {
  STAKEHOLDER
  INVESTMENT_REVIEW
  TREASURER
}

enum EducationEventCategory {
  WORKSHOP_COORDINATION
  TEACHER_ORIENTATION
  LECTURES_TOPIC_REVIEWS
}

enum HealthEventCategory {
  WELLNESS_ACTIVITIES
  WELLNESS_OFFERINGS
}

enum OperationsEventCategory {
  FACILITY_MAINTENANCE
  LOGISTICS_COORDINATION
  VOLUNTEER_MANAGEMENT
  SAFETY_COMPLIANCE
  RESOURCE_ALLOCATION
}

enum RegistrationStatus {
  REGISTERED
  WAITLISTED
  CANCELLED
  ATTENDED
}

// Communications

model ForumPost {
  id          String   @id @default(cuid())
  title       String?
  content     String
  authorId    String
  author      User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  parentId    String?
  parent      ForumPost? @relation("Replies", fields: [parentId], references: [id])
  replies     ForumPost[] @relation("Replies")

  categoryId  String?
  category    ForumCategory? @relation(fields: [categoryId], references: [id])

  isPinned    Boolean  @default(false)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([authorId])
  @@index([categoryId])
  @@index([createdAt])
}

model ForumCategory {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?

  posts       ForumPost[]

  // Link to WGO if this is a WGO discussion category
  wgo         WealthOpportunity? @relation("WGOForumCategory")

  createdAt   DateTime @default(now())
}

// Announcements

model Announcement {
  id          String   @id @default(cuid())
  title       String
  content     String
  priority    AnnouncementPriority @default(INFO)

  targetRoles UserRole[]

  isPinned    Boolean  @default(false)
  publishedAt DateTime @default(now())
  expiresAt   DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([publishedAt])
  @@index([isPinned])
}

enum AnnouncementPriority {
  URGENT
  IMPORTANT
  INFO
}

// Media Gallery System

model MediaItem {
  id           String   @id @default(cuid())
  url          String
  thumbnailUrl String
  mediumUrl    String?
  filename     String
  filesize     Int
  mimeType     String
  type         MediaType
  category     MediaCategory
  tags         String[]
  uploadedById String
  uploadedBy   User     @relation("MediaUploads", fields: [uploadedById], references: [id])
  albumItems   AlbumItem[]
  mapLocationId String?
  mapLocation  MapLocation? @relation(fields: [mapLocationId], references: [id])
  createdAt    DateTime @default(now())

  @@index([uploadedById])
  @@index([type])
  @@index([category])
  @@index([mapLocationId])
}

model Album {
  id          String   @id @default(cuid())
  name        String
  description String?
  slug        String   @unique
  items       AlbumItem[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AlbumItem {
  id          String   @id @default(cuid())
  albumId     String
  mediaItemId String
  order       Int      @default(0)

  album       Album    @relation(fields: [albumId], references: [id], onDelete: Cascade)
  mediaItem   MediaItem @relation(fields: [mediaItemId], references: [id], onDelete: Cascade)

  addedAt     DateTime @default(now())

  @@unique([albumId, mediaItemId])
  @@index([albumId])
}

enum MediaType {
  PHOTO
  VIDEO
  DRONE_FOOTAGE
  TIMELAPSE
}

enum MediaCategory {
  PROJECT_PROGRESS
  EVENTS
  SANCTUARY_NATURE
  CONSTRUCTION
  COMMUNITY
  AERIAL
}

// Interactive Maps

model MapLocation {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  latitude    Float
  longitude   Float
  type        LocationType
  status      LocationStatus @default(PLANNED)
  photos      MediaItem[]
  createdById String
  createdBy   User @relation("MapLocationsCreated", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@index([type])
  @@index([status])
}

enum LocationType {
  FACILITY
  DEVELOPMENT_ZONE
  POINT_OF_INTEREST
  NATURAL_FEATURE
  INFRASTRUCTURE
}

enum LocationStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  OPERATIONAL
}

// Learning Management System

model Course {
  id          String   @id @default(cuid())
  title       String
  description String?
  slug        String   @unique
  thumbnail   String?
  category    CourseCategory @default(OTHER)

  createdById String
  createdBy   User     @relation("CoursesCreated", fields: [createdById], references: [id])

  status      CourseStatus @default(DRAFT)
  isPublished Boolean  @default(false)

  lessons     Lesson[]
  progress    CourseProgress[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([isPublished])
  @@index([category])
}

model Lesson {
  id          String   @id @default(cuid())
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  title       String
  description String?
  order       Int      @default(0)
  type        LessonType

  videoUrl    String?
  pdfUrl      String?
  content     String?  // Markdown content

  duration    Int?     // Duration in minutes

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([courseId])
  @@index([order])
}

model CourseProgress {
  id           String   @id @default(cuid())
  userId       String
  courseId     String

  user         User     @relation("CourseProgress", fields: [userId], references: [id], onDelete: Cascade)
  course       Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  completedLessons String[] // Array of lesson IDs
  progress     Float    @default(0) // 0-100 percentage
  isCompleted  Boolean  @default(false)

  startedAt    DateTime @default(now())
  completedAt  DateTime?

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
}

enum CourseStatus {
  DRAFT
  REVIEW
  PUBLISHED
  ARCHIVED
}

enum CourseCategory {
  EMPOWERMENT
  LEADERSHIP
  WELLNESS
  FINANCE
  STEWARDSHIP
  OTHER
}

enum LessonType {
  VIDEO
  PDF
  TEXT
  QUIZ
}

// Affiliate Partners

model Partner {
  id          String   @id @default(cuid())
  name        String
  description String?
  logo        String?
  website     String?
  email       String?
  category    PartnerCategory
  status      PartnerStatus @default(PENDING)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([status])
}

enum PartnerCategory {
  ADVISORY_BOARD
  PRACTITIONER
  SPONSOR
  VENDOR
  COLLABORATOR
}

enum PartnerStatus {
  PENDING
  ACTIVE
  INACTIVE
}

// Wealth Generation Opportunities (WGO)
// Affiliate-based wealth compounding opportunities with risk tolerance ratings

model WealthOpportunity {
  id              String   @id @default(cuid())
  name            String
  description     String?
  logo            String?
  website         String?
  affiliateLink   String?  // Direct affiliate/referral link
  email           String?

  category        WGOCategory
  status          WGOStatus @default(PENDING)

  // Risk Tolerance Scale: 1-10
  // Higher value = more organizational credibility/trust
  // 10 = Highest trust, lowest perceived risk
  // 1 = Experimental, highest risk
  riskTolerance   Int      @default(5) // 1-10 scale

  // Additional opportunity details
  minimumInvestment Float?   // Minimum entry amount if applicable
  potentialReturns  String?  // Description of potential returns (e.g., "5-15% monthly")
  compoundingType   String?  // How the compounding works
  memberBenefits    String?  // Special benefits for community members

  // Trust indicators
  yearsOperating    Int?     // How long the opportunity has been running
  verifiedBy        String?  // Who verified/endorsed this opportunity
  communityRating   Float?   // Average rating from members (0-5)
  totalMembers      Int      @default(0) // Number of community members participating

  // Important disclosures
  disclaimer        String?  // Risk disclaimer text
  termsUrl          String?  // Link to full terms and conditions

  createdById       String
  createdBy         User @relation("WGOCreated", fields: [createdById], references: [id])

  // User involvements tracking
  userInvolvements  UserWGOInvolvement[] @relation("WGOInvolvements")

  // Forum category for discussions
  forumCategoryId   String?  @unique
  forumCategory     ForumCategory? @relation("WGOForumCategory", fields: [forumCategoryId], references: [id])

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([category])
  @@index([status])
  @@index([riskTolerance])
}

// Track user involvement in WGO opportunities
model UserWGOInvolvement {
  id              String   @id @default(cuid())
  userId          String
  wgoId           String

  user            User     @relation("UserWGOInvolvements", fields: [userId], references: [id], onDelete: Cascade)
  wgo             WealthOpportunity @relation("WGOInvolvements", fields: [wgoId], references: [id], onDelete: Cascade)

  // Proof of involvement
  proofType       WGOProofType  @default(LINK)
  proofUrl        String?       // URL to proof (image or link)
  proofImageUrl   String?       // Uploaded image proof

  // Status and notes
  status          WGOInvolvementStatus @default(ACTIVE)
  notes           String?       // Personal notes about involvement
  investedAmount  Float?        // Optional: amount invested
  joinedDate      DateTime?     // When they joined the opportunity

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId, wgoId])
  @@index([userId])
  @@index([wgoId])
  @@index([status])
}

enum WGOProofType {
  LINK          // External link proof
  IMAGE         // Uploaded image proof
  BOTH          // Both link and image
}

enum WGOInvolvementStatus {
  ACTIVE        // Currently involved
  PAUSED        // Temporarily paused
  EXITED        // No longer involved
}

enum WGOCategory {
  PASSIVE_INCOME        // Passive income streams
  INVESTMENT_FUND       // Investment funds and pools
  STAKING_YIELD         // Crypto staking and yield farming
  REAL_ESTATE           // Real estate investment opportunities
  BUSINESS_VENTURE      // Business partnerships
  EDUCATION_PROGRAM     // Wealth education programs
  TRADING_PLATFORM      // Trading platforms and signals
  SAVINGS_PROGRAM       // High-yield savings programs
  OTHER                 // Other opportunities
}

enum WGOStatus {
  PENDING     // Under review
  ACTIVE      // Currently available
  PAUSED      // Temporarily paused
  CLOSED      // No longer available
  SUSPENDED   // Suspended due to concerns
}

// Maintenance Requests

model MaintenanceRequest {
  id          String   @id @default(cuid())

  title       String
  description String
  location    String
  category    MaintenanceCategory
  priority    MaintenancePriority @default(MEDIUM)
  status      MaintenanceStatus @default(SUBMITTED)

  submittedById String
  submittedBy   User @relation("MaintenanceRequestsSubmitted", fields: [submittedById], references: [id])
  submittedAt   DateTime @default(now())

  assignedToId  String?
  assignedTo    User? @relation("MaintenanceRequestsAssigned", fields: [assignedToId], references: [id])
  assignedAt    DateTime?

  resolvedById  String?
  resolvedBy    User? @relation("MaintenanceRequestsResolved", fields: [resolvedById], references: [id])
  resolvedAt    DateTime?
  resolutionNotes String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([submittedById])
  @@index([assignedToId])
  @@index([status])
  @@index([priority])
}

enum MaintenanceCategory {
  PLUMBING
  ELECTRICAL
  STRUCTURAL
  GROUNDS
  HVAC
  OTHER
}

enum MaintenancePriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum MaintenanceStatus {
  SUBMITTED
  ASSIGNED
  IN_PROGRESS
  RESOLVED
}

// Document Management

model Document {
  id              String   @id @default(cuid())
  title           String
  description     String?
  category        DocumentCategory
  fileUrl         String
  fileType        String
  fileSize        Int
  mimeType        String
  uploadedById    String
  uploadedBy      User     @relation("DocumentsUploaded", fields: [uploadedById], references: [id])
  version         String   @default("1.0")
  isPublic        Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([uploadedById])
  @@index([category])
  @@index([createdAt])
}

enum DocumentCategory {
  GOVERNANCE
  FINANCIAL
  LEGAL
  EDUCATIONAL
  OPERATIONAL
}

// Committee Chat & Collaboration System

model CommitteeChat {
  id           String              @id @default(cuid())
  committeeId  String
  committee    Committee           @relation(fields: [committeeId], references: [id], onDelete: Cascade)
  category     CommitteeChatCategory @default(GENERAL)
  messages     CommitteeChatMessage[]
  summaries    CommitteeChatSummary[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@unique([committeeId, category])
  @@index([committeeId])
}

model CommitteeChatMessage {
  id         String        @id @default(cuid())
  chatId     String
  chat       CommitteeChat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  authorId   String
  author     User          @relation("ChatMessagesAuthored", fields: [authorId], references: [id], onDelete: Cascade)
  content    String
  attachmentUrl String?
  attachmentName String?
  isDeleted  Boolean       @default(false)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([chatId])
  @@index([authorId])
  @@index([createdAt])
}

model CommitteeChatSummary {
  id           String        @id @default(cuid())
  chatId       String
  chat         CommitteeChat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  weekStarting DateTime
  weekEnding   DateTime
  summary      String
  tasks        CommitteeExtractedTask[]
  generatedAt  DateTime      @default(now())

  @@unique([chatId, weekStarting])
  @@index([chatId])
  @@index([weekStarting])
}

model CommitteeExtractedTask {
  id          String               @id @default(cuid())
  summaryId   String
  summary     CommitteeChatSummary @relation(fields: [summaryId], references: [id], onDelete: Cascade)
  taskTitle   String
  taskDescription String?
  assignedToName String?
  dueDate     DateTime?
  status      ExtractedTaskStatus  @default(PENDING)
  convertedToTaskId String?
  createdAt   DateTime             @default(now())

  @@index([summaryId])
}

model CommitteeDocument {
  id              String         @id @default(cuid())
  committeeId     String
  committee       Committee      @relation(fields: [committeeId], references: [id], onDelete: Cascade)
  title           String
  description     String?
  category        DocumentCategory
  fileUrl         String
  fileName        String
  fileType        String
  fileSize        Int
  uploadedById    String
  uploadedBy      User           @relation("CommitteeDocumentsUploaded", fields: [uploadedById], references: [id])
  version         String         @default("1.0")
  isShared        Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([committeeId])
  @@index([uploadedById])
  @@index([category])
}

enum CommitteeChatCategory {
  GENERAL
  ANNOUNCEMENTS
  PROJECTS
  RESOURCES
  QUESTIONS
}

enum ExtractedTaskStatus {
  PENDING
  CONVERTED
  DISMISSED
}

// Stakeholder Pool System

enum PoolColor {
  PURPLE
  ORANGE
  GREEN
}

enum PoolStatus {
  OPEN
  GOAL_REACHED
  CLOSED
}

enum PledgeStatus {
  PENDING
  COMMITTED
  PAID
  CANCELLED
}

// Stakeholder Pool
model Pool {
  id          String     @id @default(cuid())
  name        String
  description String?
  goalAmount  Float
  status      PoolStatus @default(OPEN)
  cuts        PoolCut[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([status])
}

// Color Cut (Purple, Orange, Green)
model PoolCut {
  id          String           @id @default(cuid())
  poolId      String
  pool        Pool             @relation(fields: [poolId], references: [id], onDelete: Cascade)
  color       PoolColor
  password    String
  overseerId  String
  overseer    User             @relation("CutOverseer", fields: [overseerId], references: [id])
  invitations PoolInvitation[]
  pledges     Pledge[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([poolId, color])
  @@index([poolId])
  @@index([overseerId])
}

// Pool Invitation
model PoolInvitation {
  id           String    @id @default(cuid())
  cutId        String
  cut          PoolCut   @relation(fields: [cutId], references: [id], onDelete: Cascade)
  invitedEmail String
  invitedById  String
  invitedBy    User      @relation("InvitationsSent", fields: [invitedById], references: [id])
  acceptedAt   DateTime?
  acceptedById String?
  acceptedBy   User?     @relation("InvitationsAccepted", fields: [acceptedById], references: [id])
  expiresAt    DateTime
  createdAt    DateTime  @default(now())

  @@unique([cutId, invitedEmail])
  @@index([cutId])
  @@index([invitedEmail])
}

// Pledge Record
model Pledge {
  id         String       @id @default(cuid())
  cutId      String
  cut        PoolCut      @relation(fields: [cutId], references: [id], onDelete: Cascade)
  memberId   String
  member     User         @relation("MemberPledges", fields: [memberId], references: [id])
  amount     Float
  status     PledgeStatus @default(PENDING)
  paidAt     DateTime?
  paymentRef String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@unique([cutId, memberId])
  @@index([cutId])
  @@index([memberId])
  @@index([status])
}

// Communal Seat Submission System
// For Communal Seat Organization document submissions

model CommunalSeatSubmission {
  id                String   @id @default(cuid())

  // Applicant Information
  fullName          String
  email             String
  phone             String

  // Service Details
  serviceDescription String   // Description of the service they can provide
  yearsExperience   Int
  certifications    String?   // Certifications or licenses held
  websiteLink       String?   // Website or portfolio link
  motivation        String    // Why they want to participate

  // Document
  documentUrl       String    // URL to uploaded PDF document
  documentFileName  String    // Original file name

  // Categories (multiple can be selected)
  categories        CommunalSeatServiceCategory[]

  // Status
  status            CommunalSeatStatus @default(PENDING)

  // Submitter
  submittedById     String
  submittedBy       User     @relation("CommunalSeatSubmissions", fields: [submittedById], references: [id])

  // Review
  reviewedById      String?
  reviewedBy        User?    @relation("CommunalSeatReviews", fields: [reviewedById], references: [id])
  reviewedAt        DateTime?
  reviewNotes       String?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([submittedById])
  @@index([status])
  @@index([createdAt])
}

enum CommunalSeatServiceCategory {
  HEALING_SERVICE           // Healing Service
  ORGANIZATIONAL_SERVICE    // Organizational Service
  CUSTOMER_SERVICE          // Customer Service
  TECHNOLOGY_PROVISION      // Technology Provision Service
  CULINARY_SERVICE          // Culinary Service
  UTILITY_SERVICE           // Utility Service
  OCCUPATIONAL_SERVICES     // Occupational Services
  AGRICULTURAL_SERVICES     // Agricultural Services
  ASSOCIATION_SERVICES      // Association Services
}

enum CommunalSeatStatus {
  PENDING     // Awaiting review
  APPROVED    // Approved for communal seat
  REJECTED    // Not approved
}
