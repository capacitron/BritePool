# Database
DATABASE_URL="postgresql://user:password@localhost:5432/britepool?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-here-generate-with-openssl-rand-base64-32"

# Stripe
STRIPE_SECRET_KEY="sk_test_your_key_here"
STRIPE_PUBLISHABLE_KEY="pk_test_your_key_here"
STRIPE_WEBHOOK_SECRET="whsec_your_webhook_secret_here"
STRIPE_PRICE_BASIC="price_your_basic_price_id"
STRIPE_PRICE_PREMIUM="price_your_premium_price_id"
STRIPE_PRICE_PLATINUM="price_your_platinum_price_id"

# Email (Resend)
RESEND_API_KEY="re_your_api_key_here"
FROM_EMAIL="noreply@britepool.org"
FROM_NAME="BRITE POOL"

# ActiveCampaign
ACTIVECAMPAIGN_API_URL="https://youraccountname.api-us1.com"
ACTIVECAMPAIGN_API_KEY="your_api_key_here"

# Bunny.net CDN (Video Stream + Storage)
BUNNY_STREAM_API_KEY="your_stream_library_api_key"
BUNNY_STREAM_LIBRARY_ID="your_stream_library_id"
BUNNY_STREAM_CDN_HOSTNAME="vz-xxxxx.b-cdn.net"
BUNNY_STORAGE_ZONE="britepool-assets"
BUNNY_STORAGE_PASSWORD="your_storage_zone_password"
BUNNY_STORAGE_CDN_HOSTNAME="britepool.b-cdn.net"

# Mapbox (for interactive maps)
NEXT_PUBLIC_MAPBOX_TOKEN="pk.your_mapbox_token_here"

# Environment
NODE_ENV="development"
